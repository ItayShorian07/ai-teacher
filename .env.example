# Copy to .env.local (ignored by Git) and configure the same values in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://ai-teacher-three-pied.vercel.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secrets. Never commit real values or prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Also enable Email/password (minimum 12 characters), Confirm Email, Google,
# SMTP and CAPTCHA in Supabase. Apply database/setup.sql or migration 005.
# Add {{ .Token }} to Confirm signup, Magic Link and Reset Password templates.
# SUPABASE_SERVICE_ROLE_KEY is required for private username lookup; never expose it.
