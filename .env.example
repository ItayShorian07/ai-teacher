# Empty values keep account creation disabled and leave the public demo accessible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://ai-teacher-three-pied.vercel.app
# Optional CAPTCHA site key; configure the corresponding secret in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# For local Supabase/OAuth testing, change SITE_URL to http://127.0.0.1:3000
# Google, SMTP and SMS credentials belong in Supabase/provider dashboards.
# Never expose a Supabase secret/service_role key through NEXT_PUBLIC_ variables.
# Future learning integrations, not used by this demo:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# MATERIALS_SUPABASE_URL=
# MATERIALS_SUPABASE_SECRET_KEY=
# QUESTIONS_SUPABASE_URL=
# QUESTIONS_SUPABASE_SECRET_KEY=
