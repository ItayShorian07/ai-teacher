# Local development only. Use separate values for Vercel Preview and Production.
# Register the public Supabase URLs in config/environments.json first.
APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secrets. Never commit real values or prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# On Vercel, APP_ENV must match VERCEL_ENV (preview or production).
# Preview: leave NEXT_PUBLIC_SITE_URL unset to use VERCEL_BRANCH_URL.
# Production: set NEXT_PUBLIC_SITE_URL to the registered production origin.
# Configure Google, SMTP, CAPTCHA and redirect URLs separately in each project.
