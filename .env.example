# Local development only. Use separate values for Vercel Preview and Production.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://rviepntsesloohctatao.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secrets. Never commit real values or prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Vercel Preview: NEXT_PUBLIC_APP_ENV=preview, NEXT_PUBLIC_SUPABASE_ENV=development.
# Vercel Production: both environment labels must be production.
# Preview: leave NEXT_PUBLIC_SITE_URL unset to use VERCEL_BRANCH_URL.
# Production: set NEXT_PUBLIC_SITE_URL to the registered production origin.
# Configure Google, SMTP, CAPTCHA and redirect URLs separately in each project.

# Also enable Email/password (minimum 12 characters), Confirm Email, Google,
# SMTP and CAPTCHA in Supabase. Apply database/setup.sql or migration 005.
# Add {{ .Token }} to Confirm signup, Magic Link and Reset Password templates.
# SUPABASE_SERVICE_ROLE_KEY is required for private username lookup; never expose it.
